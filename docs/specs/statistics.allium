-- allium: 3
--
-- Poodl — statistics and the answer pool
--
-- Scope
--   The two things Poodl remembers across games: how the player has done, and
--   which answers have already been used.
--
-- Includes
--   - One primary statistics block: games played, wins, win percentage,
--     current and maximum streak, and the distribution of winning guess
--     counts.
--   - Which games count. Only random and endless games ever touch the block.
--     Practice records nothing at all; custom games record nothing either.
--   - How a completion moves the numbers, including an abandoned game, which
--     counts as a loss.
--   - The answer pool: random and endless draw from one shared set of
--     answers not yet used, and the used set clears when it runs out. That
--     it has run out is visible to the player.
--   - Starting over: one action clears the numbers and the pool together.
--
-- Excludes
--   - Playing a game (game.allium). This module never reads a guess; it
--     reads only the requested mode, the outcome, the attempt count and
--     whether the game counted.
--   - Per-mode or per-day breakdowns. There is one block, not several.
--   - Where the numbers are stored.
--
-- Dependencies
--   game.allium — Game, its lifecycle and its attempt count.
--   words.allium — the answer list the pool draws from.

use "./game.allium" as game
use "./words.allium" as words

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- The one statistics block. There is exactly one, declared as a default below
-- rather than created by any rule.
entity Statistics {
    games_played: Integer
    wins: Integer
    current_streak: Integer
    max_streak: Integer

    -- Relationships
    buckets: GuessDistributionBucket with statistics = this

    -- Derived
    losses: games_played - wins
    win_percentage: if games_played = 0: 0.0 else: wins * 100.0 / games_played

    invariant WinsFallWithinGamesPlayed {
        wins >= 0 and wins <= games_played
    }

    invariant CurrentStreakNeverExceedsMaximum {
        current_streak >= 0 and current_streak <= max_streak
    }

    -- The distribution counts wins and only wins, so it accounts for every
    -- win and nothing else. A loss moves games_played and the streak, never a
    -- bucket.
    invariant DistributionAccountsForEveryWin {
        sum(buckets, b => b.win_count) = wins
    }

    invariant StreakCannotExceedWins {
        current_streak <= wins
    }
}

-- One bucket per attempt count: how many games were won in that many guesses.
entity GuessDistributionBucket {
    statistics: Statistics
    guesses_used: Integer
    win_count: Integer

    invariant BucketIsAnAttemptNumber {
        guesses_used >= 1 and guesses_used <= game/config.max_attempts
    }

    invariant WinCountIsNeverNegative {
        win_count >= 0
    }
}

-- The answers random and endless have already served up. Practice ignores
-- this entirely, and custom games never come near it.
entity AnswerPool {
    used: Set<words/Word>

    -- Whether the pool has ever run out and started again. A count of unused
    -- answers cannot stand in for this: on exhaustion the used set is
    -- immediately refilled with the word just drawn, so the count is non-zero
    -- again by the time anybody reads it.
    has_recycled: Boolean

    invariant OnlyAnswerWordsAreRecorded {
        used.all(w => w.in_answer_list)
    }
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

default Statistics primary = {
    games_played: 0,
    wins: 0,
    current_streak: 0,
    max_streak: 0
}

default GuessDistributionBucket bucket_one = { statistics: primary, guesses_used: 1, win_count: 0 }
default GuessDistributionBucket bucket_two = { statistics: primary, guesses_used: 2, win_count: 0 }
default GuessDistributionBucket bucket_three = { statistics: primary, guesses_used: 3, win_count: 0 }
default GuessDistributionBucket bucket_four = { statistics: primary, guesses_used: 4, win_count: 0 }
default GuessDistributionBucket bucket_five = { statistics: primary, guesses_used: 5, win_count: 0 }
default GuessDistributionBucket bucket_six = { statistics: primary, guesses_used: 6, win_count: 0 }

default AnswerPool pool = { used: {}, has_recycled: false }

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Recording an outcome ---------------------------------------------------

-- A win: one more game, one more win, a longer streak, and a mark in the
-- bucket for however many guesses it took.
rule RecordWin {
    when: g: game/Game.status transitions_to won

    let attempts = g.attempts_used
    let bucket = GuessDistributionBucket{statistics: primary, guesses_used: attempts}
    let streak = primary.current_streak + 1

    requires: g.is_stat_eligible
    requires: exists bucket

    ensures:
        primary.games_played = primary.games_played + 1
        primary.wins = primary.wins + 1
        primary.current_streak = streak
        bucket.win_count = bucket.win_count + 1
        if streak > primary.max_streak:
            primary.max_streak = streak

    @guidance
        -- The streak is bound before the ensures block so that both the new
        -- current streak and any new maximum are the same number. Writing
        -- max_streak = current_streak instead would store the streak as it
        -- was before this win, because the right-hand side of a state change
        -- reads pre-rule values.
}

-- A loss: the game counts, the streak goes, and the distribution is
-- untouched.
rule RecordLoss {
    when: g: game/Game.status transitions_to lost

    requires: g.is_stat_eligible

    ensures:
        primary.games_played = primary.games_played + 1
        primary.current_streak = 0
}

-- Walking away from a game that was under way is a loss. A game with no
-- guesses in it never reaches this state: game.allium discards it instead, so
-- it costs the player nothing.
--
-- This chains from the emission rather than from the transition, and reads
-- only its parameters. game.allium discards an abandoned game once it has
-- been retired, and nothing here may depend on reaching that game afterwards.
rule RecordAbandonmentAsLoss {
    when: game/GameAbandoned(_, attempts, stat_eligible)

    requires: stat_eligible
    requires: attempts >= 1

    ensures:
        primary.games_played = primary.games_played + 1
        primary.current_streak = 0
}

-- Drawing an answer ------------------------------------------------------

-- Random and endless draw uniformly from the answers not yet used, and record
-- what they drew. When nothing is left, the used set clears and drawing
-- carries on from the whole list, so answers may repeat from then on.
rule DrawPooledAnswer {
    when: game/NewGameRequested(player, mode)

    requires: mode in {random, endless}

    let answers = words/answer_words()
    let unused = filter(answers, w => w not in pool.used)
    let pool_exhausted = unused.count = 0
    let candidates = if pool_exhausted: answers else: unused
    let drawn = uniform_choice(candidates)

    ensures:
        if pool_exhausted:
            pool.used = { drawn }
            pool.has_recycled = true
        else:
            pool.used = pool.used + { drawn }
        if mode = random:
            game/AnswerDrawn(player: player, mode: random, answer: drawn)
        else:
            game/AnswerDrawn(player: player, mode: endless, answer: drawn)

    @guidance
        -- uniform_choice must give every candidate the same chance. It is the
        -- one deliberately non-deterministic step here, so it is uniformity
        -- that matters, not repeatability.
        --
        -- On exhaustion the used set is replaced by the word just drawn
        -- rather than emptied, so the reset and the record happen together
        -- and the new cycle starts with one answer already spent.
        --
        -- The mode is emitted branch by branch because the request carries a
        -- StartableMode and a game carries a GameMode. They are separate
        -- types so that the conversion has to be written out; the requires
        -- clause above has already narrowed this to two possibilities.
}

-- Starting over ----------------------------------------------------------

-- One action clears one record of play. The pool goes with the numbers
-- because they are the same record seen from two sides, and because clearing
-- browser data — the only other way to start over — has always cleared both.
rule PlayerResetsStatistics {
    when: PlayerResetsStatistics(player)

    ensures:
        primary.games_played = 0
        primary.wins = 0
        primary.current_streak = 0
        primary.max_streak = 0
        for b in primary.buckets:
            b.win_count = 0
        pool.used = {}
        pool.has_recycled = false
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface StatisticsPanel {
    facing viewer: game/Player

    let stats = primary
    let answers_unseen = filter(words/answer_words(), w => w not in pool.used).count
    let answers_may_repeat = pool.has_recycled

    exposes:
        stats.games_played
        stats.wins
        stats.losses
        stats.win_percentage
        stats.current_streak
        stats.max_streak
        answers_unseen
        answers_may_repeat
        for bucket in stats.buckets:
            bucket.guesses_used
            bucket.win_count

    provides:
        PlayerResetsStatistics(viewer)

    contracts:
        fulfils game/DirectManipulation

    @guarantee OnlyRandomAndEndlessAreCounted
        -- Practice and custom games never move any number on this panel.
        -- Practice keeps no record of any kind: no games played, no answers
        -- recorded, nothing.

    @guarantee AbandonmentCostsTheSameAsALoss
        -- Leaving a stat-eligible game part way through — starting a new
        -- game, switching mode, or opening a custom link — counts a game
        -- played and resets the current streak, exactly as losing does.
        -- Leaving before guessing at all costs nothing.

    @guarantee DistributionIsReadableWithoutSeeingIt
        -- Each bucket's attempt number and count are available as text, so
        -- the distribution can be read by assistive technology rather than
        -- inferred from the length of a bar.

    @guarantee StatisticsPersistBetweenSessions
        -- Every number on this panel, and the pool of already-used answers,
        -- persists between sessions on the same device and browser.

    @guarantee RecyclingIsVisibleBeforeItSurprises
        -- How many answers remain unseen is available as text, and once the
        -- pool has run out and started again the panel says so. A player who
        -- meets a word twice can see why rather than doubting the game.

    @guarantee ResettingClearsThePoolToo
        -- Resetting sets every number to zero and empties the record of used
        -- answers together. They are one record of play, so afterwards the
        -- statistics are untouched by history and every answer can be drawn
        -- again.

    @guarantee ResettingIsDeliberate
        -- Resetting is confirmed before anything is cleared, and the
        -- confirmation says what will go: the numbers, the streaks, the
        -- distribution and the record of which answers have been seen.
        -- Nothing here is recoverable afterwards.

    @guarantee FullyKeyboardOperable
        -- The panel can be opened, read, reset and dismissed from the
        -- keyboard alone, and the reset confirmation is reachable and
        -- announced.
}
