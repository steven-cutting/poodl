-- allium: 3
--
-- Poodl — word lists
--
-- Scope
--   The two word lists Poodl plays from, the order the daily word follows
--   through the answer list, and the properties every entry must satisfy.
--   This module knows nothing about games, guesses, scoring, statistics or
--   days.
--
-- Includes
--   - The Word entity, and its membership of the curated answer list and of
--     the larger valid-guess dictionary.
--   - Shape obligations on every entry: exactly five letters, lowercase,
--     one entry per distinct word.
--   - The obligation that every answer is itself a valid guess.
--   - The one word this specification does name: the game's own, which is
--     always playable and always drawable.
--   - Size floors on both lists, so a truncated data file fails rather than
--     ships.
--   - The provisioning contract through which the lists arrive: they are
--     replaceable data, not content authored in this specification, and the
--     guess dictionary only ever grows.
--   - The daily schedule: the answer list in a fixed order, supplied as data
--     like the lists, whose positions never move once shipped.
--
-- Excludes
--   - Curation. How a word is judged familiar enough for the answer list, and
--     where either list comes from, is outside this specification; see the
--     deferred WordListCuration below.
--   - Any notion of play: a game, an attempt, a mark, a statistic.
--   - Which day plays which entry of the schedule (daily.allium).
--   - How the lists are stored, encoded, bundled or loaded.
--
-- Dependencies
--   None. This is the root module. game.allium, statistics.allium,
--   sharing.allium and daily.allium depend on it.

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- The lists are supplied to the product as data. Replacing the data replaces
-- the playable vocabulary without any change to behaviour specified here.
--
-- The intended sizes are roughly 1,100 answer words and roughly 15,000
-- dictionary words. Those figures are design intent, but the floors beneath
-- them are not: a truncated data file has to fail rather than ship as a
-- playable but tiny vocabulary.
contract WordListSource {
    answer_words: () -> Set<Word>
    guess_words: () -> Set<Word>
    daily_schedule: () -> List<Word>

    @invariant EveryEntryIsAFiveLetterLowercaseWord
        -- Every word in either list is exactly config.word_length letters
        -- long and contains only lowercase letters of the English alphabet.

    @invariant NoDuplicatesWithinAList
        -- Neither list contains the same word twice.

    @invariant AnswersAreASubsetOfGuesses
        -- Every word in answer_words also appears in guess_words. A player
        -- can therefore always type the answer as a guess.

    @invariant TheSetsAreTheMembershipFlags
        -- answer_words() is exactly the Words carrying in_answer_list, and
        -- guess_words() exactly the Words carrying in_guess_dictionary. The
        -- contract's sets and the entity's flags are one fact stated from
        -- two sides, so a rule may draw from answer_words() while an
        -- invariant filters on the flag, and neither can drift from the
        -- other.

    @invariant AnswerListIsFamiliarVocabulary
        -- The answer list is curated for familiarity: a player who loses
        -- should recognise the answer. The guess dictionary carries no such
        -- obligation and is expected to contain obscure words.

    @invariant TheGameNameIsAlwaysSupplied
        -- Every supply of the lists includes config.game_name in
        -- answer_words, and therefore in guess_words. Curation is otherwise
        -- free, but it may not drop this one entry.

    @invariant ListsAreStableWithinASession
        -- Both lists are fully available before the first game starts and do
        -- not change while a game is in progress.

    @invariant TheGuessDictionaryIsAppendOnlyAcrossReleases
        -- A later supply of the lists contains every word the previous one
        -- had in guess_words. Words may be added, and the answer list may be
        -- re-curated freely within the dictionary, but no word is ever
        -- withdrawn from guess_words. A game in progress therefore keeps an
        -- answer Poodl still accepts, and a custom link issued by an earlier
        -- release still decodes to a word that can be played, so replacing
        -- the lists invalidates nothing that is already in someone's hands.

    @invariant TheScheduleIsTheAnswerListInAFixedOrder
        -- daily_schedule() holds exactly the words of answer_words(), each
        -- exactly once, in an order the supply fixes. It is the answer list
        -- with an order, not a third vocabulary: a word joins the schedule
        -- when it joins the answer list, and no word is scheduled that a
        -- losing player could not be shown.

    @invariant SchedulePositionsAreFrozenAcrossReleases
        -- A later supply keeps every entry of the previous one at the same
        -- position. New words are appended after the last entry; a word
        -- withdrawn from the answer list is replaced at its position by one
        -- not already scheduled, never removed; nothing is inserted or
        -- reordered. So nothing before the end ever moves, and a day already
        -- scheduled keeps its word — the daily counterpart of the append-only
        -- dictionary above, and what lets the answer list grow without
        -- disturbing a single day.

    @guidance
        -- The lists and the schedule are expected to ship as separate
        -- replaceable data files. Nothing in this specification depends on
        -- the order of either list, so a source may present them in any
        -- order it likes. The schedule is the exception: its order is its
        -- whole content, and a useful one is a shuffle rather than the sorted
        -- order the answer list is kept in, because a schedule in that order
        -- would walk the alphabet a day at a time.
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- A single playable word. The two lists are modelled as membership flags on
-- one entry rather than as two collections, so that the relationship between
-- them (every answer is a valid guess) is stated directly and checkably.
entity Word {
    text: String

    -- Membership
    in_answer_list: Boolean
    in_guess_dictionary: Boolean

    invariant EntryIsWordLength {
        length(text) = config.word_length
    }

    invariant EntryIsLowercase {
        text = lowercase(text)
    }

    invariant EveryAnswerIsAValidGuess {
        in_answer_list implies in_guess_dictionary
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    word_length: Integer = 5

    -- The game's own name, and the only word this specification names. It is
    -- a parameter rather than a literal in the invariant below so that the
    -- name appears once, and so that a fork playing under another name states
    -- its own here. It is not exempt from anything: like every other entry it
    -- must be word_length letters and lowercase, which is what makes this
    -- expressible at all.
    game_name: String = "poodl"

    -- Floors, not targets. They exist so that a truncated or half-written
    -- data file fails outright instead of shipping as a vocabulary small
    -- enough to repeat answers within a sitting.
    min_answer_words: Integer = 1000
    min_guess_words: Integer = 10000
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- One entry per distinct word. Uniqueness across the single Word collection
-- gives uniqueness within each list, and lets a guess be resolved to at most
-- one entry by its text.
invariant WordTextIsUnique {
    for a in Words:
        for b in Words:
            a != b implies a.text != b.text
}

-- Drawing an answer must always be possible, and must stay possible for long
-- enough to be worth doing. A list that has lost most of its entries is a
-- broken build, not a small one.
invariant AnswerListMeetsItsMinimum {
    filter(Words, w => w.in_answer_list).count >= config.min_answer_words
}

invariant GuessDictionaryMeetsItsMinimum {
    filter(Words, w => w.in_guess_dictionary).count >= config.min_guess_words
}

-- The game's name is an ordinary answer word: it can be typed, it can be
-- drawn, it can be sent as a custom link. A game named after a word that
-- Poodl itself rejects would be a strange thing to ship.
--
-- This is the one place curation is constrained from inside the
-- specification, and the familiarity obligation is the reason it is allowed
-- to be: whoever is looking at the board knows the name of the game they are
-- playing, so an unfamiliar answer is exactly what this is not. Membership of
-- the guess dictionary follows from EveryAnswerIsAValidGuess and is not
-- restated here.
invariant GameNameIsInTheAnswerList {
    Words.any(w => w.text = config.game_name and w.in_answer_list)
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The boundary between this specification and whatever supplies the lists.
-- The counterpart is data, not a person.
surface WordListProvisioning {
    exposes:
        Word

    contracts:
        demands WordListSource

    @guarantee ListsAreReplaceableWithoutSpecChange
        -- Swapping either list for a different set of words that satisfies
        -- WordListSource changes what Poodl plays with and nothing else. No
        -- rule in any module names a specific word. The one thing a
        -- replacement must carry over is config.game_name, which every
        -- supply is obliged to contain. The schedule is replaceable only on
        -- the terms SchedulePositionsAreFrozenAcrossReleases states —
        -- appended to, or repaired in place, and never reordered — because
        -- its order is the one thing every supply carries forward.

    @guarantee OnlyTheGameNameIsAuthoredHere
        -- This specification contains no word list content beyond
        -- config.game_name. Apart from that single entry it states only what
        -- any supplied list must satisfy, and it names no other word.

    @guarantee ReplacingTheListsBreaksNothingAlreadyInPlay
        -- Because the guess dictionary only ever grows, a release that
        -- changes the lists leaves every game in progress playable and every
        -- custom link already issued still openable. A player is never
        -- interrupted mid-game, and a link handed to a friend last month
        -- does not stop working because the vocabulary moved on. And because
        -- the schedule's positions are frozen, every day already scheduled
        -- keeps its word: a release lands without changing what today's
        -- players are playing.
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

-- How the answer list is selected and pruned for familiarity.
deferred WordListCuration.curate    -- see: outside this specification; the lists arrive through WordListSource
