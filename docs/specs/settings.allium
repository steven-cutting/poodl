-- allium: 3
--
-- Poodl — settings
--
-- Scope
--   The player's preferences, when each may be changed, and how two of them
--   negotiate with preferences expressed by the operating system.
--
-- Includes
--   - Theme, high contrast, hard mode, animations, physical-keyboard input
--     and whether opening Poodl lands on the welcome screen.
--   - The guard on turning hard mode on part way through a game. Turning it
--     off is never guarded, but during a game that has guesses in it, doing
--     so is a one-way door: it cannot be turned back on until the next game.
--   - Theme following the system until the player chooses otherwise, and
--     animations deferring to a reduced-motion preference.
--
-- Excludes
--   - What hard mode does to a guess. That is game.allium's business; this
--     module only decides when the flag may change.
--   - What high contrast does to the shared emoji grid (sharing.allium).
--   - Colour values, palettes, markup and animation mechanics.
--
-- Dependencies
--   game.allium — the Player, and the game in progress that the hard-mode
--   guard has to inspect.
--
--   game.allium declares an external PlaySettings entity with hard_mode,
--   physical_keyboard and show_welcome on it, and reads those three fields
--   live — the first two while playing, the third on arriving. The Settings
--   entity below is what supplies them: one source of truth, named from two
--   sides so that the dependency runs one way only.

use "./game.allium" as game

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    -- Preferences the player expressed to their operating system rather than
    -- to Poodl. Poodl reads them and never writes them.
    device: DevicePreferences
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity DevicePreferences {
    prefers_dark_colour_scheme: Boolean
    prefers_reduced_motion: Boolean
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- system means "whatever the device asks for, as it changes". light and dark
-- are the player overriding that.
enum ThemeChoice { system | light | dark }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Settings {
    theme: ThemeChoice
    high_contrast: Boolean
    hard_mode: Boolean
    animations: Boolean
    physical_keyboard: Boolean

    -- Whether opening Poodl lands on the welcome screen. Off goes straight to
    -- continuing, but only when there is something to continue: game.allium
    -- shows the screen regardless rather than stranding a player on an empty
    -- board.
    show_welcome: Boolean
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

-- One settings record, existing from the first visit. Theme starts at system,
-- so Poodl matches the device until the player says otherwise.
default Settings player_settings = {
    theme: system,
    high_contrast: false,
    hard_mode: false,
    animations: true,
    physical_keyboard: true,
    show_welcome: true
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule PlayerChoosesTheme {
    when: PlayerChoosesTheme(player, choice)

    requires: player_settings.theme != choice

    ensures: player_settings.theme = choice
}

rule PlayerSetsHighContrast {
    when: PlayerSetsHighContrast(player, enabled)

    requires: player_settings.high_contrast != enabled

    ensures: player_settings.high_contrast = enabled
}

rule PlayerSetsAnimations {
    when: PlayerSetsAnimations(player, enabled)

    requires: player_settings.animations != enabled

    ensures: player_settings.animations = enabled
}

rule PlayerSetsPhysicalKeyboard {
    when: PlayerSetsPhysicalKeyboard(player, enabled)

    requires: player_settings.physical_keyboard != enabled

    ensures: player_settings.physical_keyboard = enabled
}

rule PlayerSetsShowWelcome {
    when: PlayerSetsShowWelcome(player, enabled)

    requires: player_settings.show_welcome != enabled

    ensures: player_settings.show_welcome = enabled
}

-- Hard mode may be turned on part way through a game on two conditions: it
-- was not switched off during this game, and nothing already submitted would
-- have broken it. With no guesses submitted the second is trivially true, so
-- between games it can always be turned on.
--
-- Both guards earn their place. hard_mode_released catches the player who
-- switched it off to escape the constraint; hard_mode_admissible catches the
-- game where hard mode was simply never on and the guesses so far would not
-- have complied.
rule PlayerEnablesHardMode {
    when: PlayerEnablesHardMode(player)

    let current = player.current_game

    requires: player_settings.hard_mode = false
    requires: not exists current
        or current.status != in_progress
        or (not current.hard_mode_released and current.hard_mode_admissible)

    ensures: player_settings.hard_mode = true
}

-- Turning it off is never guarded: relaxing the constraint invalidates no
-- history, and a player who wants out of hard mode gets out immediately.
-- Doing so part way through a game is a one-way door, though — the game
-- remembers, and hard mode cannot come back until the next one.
rule PlayerDisablesHardMode {
    when: PlayerDisablesHardMode(player)

    let current = player.current_game

    requires: player_settings.hard_mode = true

    ensures:
        player_settings.hard_mode = false
        if exists current and current.status = in_progress and current.attempts_used >= 1:
            current.hard_mode_released = true

    @guidance
        -- A game with no guesses in it is untouched: turning hard mode off
        -- before playing anything is the same as never having had it on, so
        -- it can be turned straight back on.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface SettingsPanel {
    facing viewer: game/Player

    let settings = player_settings
    let current = viewer.current_game
    let hard_mode_may_be_enabled =
        not exists current
        or current.status != in_progress
        or (not current.hard_mode_released and current.hard_mode_admissible)

    exposes:
        settings.theme
        settings.high_contrast
        settings.hard_mode
        settings.animations
        settings.physical_keyboard
        settings.show_welcome
        hard_mode_may_be_enabled

    provides:
        PlayerChoosesTheme(viewer, choice)
        PlayerSetsHighContrast(viewer, enabled)
        PlayerSetsAnimations(viewer, enabled)
        PlayerSetsPhysicalKeyboard(viewer, enabled)
        PlayerSetsShowWelcome(viewer, enabled)
        PlayerEnablesHardMode(viewer)
            when not settings.hard_mode and hard_mode_may_be_enabled
        PlayerDisablesHardMode(viewer)
            when settings.hard_mode

    contracts:
        fulfils game/DirectManipulation

    @guarantee HardModeIsExplainedWhenItCannotBeTurnedOn
        -- hard_mode_may_be_enabled is exposed so that an unavailable
        -- hard-mode control can say which of the two reasons applies: it was
        -- switched off part way through this game, or a guess already
        -- submitted would have broken the rule. The explanation is available
        -- to assistive technology, not only as a visual state.

    @guarantee TurningHardModeOffMidGameIsAOneWayDoor
        -- Switching hard mode off during a game that has guesses in it bars
        -- turning it back on until the next game. The control says so before
        -- it is used, so the cost is known in advance rather than discovered
        -- afterwards. A game with no guesses in it costs nothing: hard mode
        -- can be turned straight back on.

    @guarantee HighContrastGovernsTheSharedGridToo
        -- One preference, not two. Turning high contrast on changes the
        -- colours on screen and the emoji in a shared result together, so
        -- what gets pasted into a message matches the board it came from.

    @guarantee PhysicalKeyboardInputCanBeSurrenderedToAssistiveTechnology
        -- physical_keyboard exists so that Poodl's handling of key presses
        -- never blocks a screen reader's own navigation, which uses letter
        -- keys. Off surrenders the whole channel — letters, Enter and
        -- Backspace alike — and the control says as much, so it never reads
        -- as though it would make the game unplayable.

    @guarantee HardModeCanAlwaysBeTurnedOff
        -- Turning hard mode off is available at every point in a game.

    @guarantee TheseSettingsGovernPlayImmediately
        -- hard_mode and physical_keyboard are what game.allium reads through
        -- its PlaySettings abstraction while a game is being played. A change
        -- applies to the game already on the board, from the very next key
        -- press or submission.

    @guarantee TheWelcomeSettingAppliesAtTheNextArrival
        -- show_welcome reaches game.allium through the same abstraction, but
        -- it governs opening rather than playing. Changing it leaves the
        -- board alone and takes effect the next time Poodl is opened.

    @guarantee SettingsPersistBetweenSessions
        -- Every setting persists between sessions on the same device and
        -- browser.

    @guarantee FullyKeyboardOperable
        -- Every control here can be reached, read and operated from the
        -- keyboard alone, and each one's current state is announced.
}

-- How Poodl looks, decided jointly by the player's settings and the device.
-- This surface applies everywhere, not only inside the settings panel.
surface Appearance {
    facing viewer: game/Player

    let settings = player_settings
    let dark_active =
        if settings.theme = system: device.prefers_dark_colour_scheme
        else: settings.theme = dark
    let animations_active = settings.animations and not device.prefers_reduced_motion

    exposes:
        dark_active
        animations_active
        settings.high_contrast

    @guarantee ThemeFollowsTheDeviceUntilThePlayerChooses
        -- While theme is system, Poodl matches the device's colour scheme and
        -- keeps matching it as it changes. Once the player picks light or
        -- dark, that choice holds and the device is no longer consulted.

    @guarantee ReducedMotionOverridesTheAnimationSetting
        -- Animations run only when the animations setting is on and the
        -- device expresses no reduced-motion preference. The device
        -- preference wins: a player who asked their system for less motion
        -- gets none from Poodl, whatever the setting says.

    @guarantee AppearanceNeverCarriesMeaningAlone
        -- Neither the theme nor high contrast is what makes a result
        -- readable. Letter results stay distinguishable without relying on
        -- colour in any combination of these settings.
}
